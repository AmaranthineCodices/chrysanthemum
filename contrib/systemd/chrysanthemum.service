[Unit]
Description=Chrysanthemum Discord bot
After=network.target

[Service]
Type=simple
Restart=always
ExecStart=/usr/local/bin/chrysanthemum
WorkingDirectory=/usr/share/chrysanthemum
EnvironmentFile=/usr/share/chrysanthemum/.env
DynamicUser=yes
StandardOutput=journal

[Install]
WantedBy=multi-user.target
